<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splash"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_pantalla_degradado"
    android:gravity="center"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="@dimen/logo_splash"
        android:layout_height="@dimen/logo_splash"
        android:background="@drawable/bg_logo_circulo">

        <ImageView
            android:layout_width="@dimen/icono_logo"
            android:layout_height="@dimen/icono_logo"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_letra_a" />
    </FrameLayout>

    <TextView
        style="@style/TextoTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_l"
        android:text="@string/app_name" />
</LinearLayout>